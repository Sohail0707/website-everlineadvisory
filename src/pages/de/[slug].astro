---
/**
 * Any other German page ("/de/about/"…), one per Sanity `page` document.
 * Static build: getStaticPaths lists every page up front.
 * Preview build (server output): getStaticPaths is skipped and the page is looked up per request,
 * so a page an editor just created shows up without a rebuild.
 */
import SanityPage from '../../components/SanityPage.astro';
import { loadPage, staticPaths } from '../../lib/sanity/load-page';
import { isDraftMode } from '../../lib/draft-mode';

export function getStaticPaths() {
  return staticPaths('de');
}

const draftMode = isDraftMode(Astro.cookies);
const result = await loadPage('de', Astro.params.slug!, draftMode);
// No such page. (Not Astro.rewrite('/404'): in server mode the 404 page is a pre-rendered file,
// and rewriting to it from a server-rendered route is not allowed.)
if (!result) return new Response('Not found', { status: 404 });
---

<SanityPage {...result} lang="de" draftMode={draftMode} />
