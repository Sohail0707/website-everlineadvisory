---
/** German home page ("/de/"). The content is the Sanity `page` with slug "home" and language "de". */
import SanityPage from '../../components/SanityPage.astro';
import { loadPage } from '../../lib/sanity/load-page';
import { isDraftMode } from '../../lib/draft-mode';

const draftMode = isDraftMode(Astro.cookies);
const result = await loadPage('de', 'home', draftMode);
if (!result) throw new Error('No German "home" page in Sanity. Run the seed script (README → Seed).');
---

<SanityPage {...result} lang="de" draftMode={draftMode} />
