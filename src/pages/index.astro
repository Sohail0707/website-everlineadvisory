---
/** English home page ("/"). The content is the Sanity `page` with slug "home" and language "en". */
import SanityPage from '../components/SanityPage.astro';
import { loadPage } from '../lib/sanity/load-page';
import { isDraftMode } from '../lib/draft-mode';

const result = await loadPage('en', 'home', isDraftMode(Astro.cookies));
if (!result) throw new Error('No English "home" page in Sanity. Run the seed script (README → Seed).');
---

<SanityPage {...result} lang="en" />
