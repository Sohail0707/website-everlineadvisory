---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadQuery } from '../lib/sanity/load-query';
import { SETTINGS_QUERY } from '../lib/sanity/queries';
import type { SETTINGS_QUERY_RESULT } from '../lib/sanity/sanity.types';

// Always pre-rendered, also in the preview build: Netlify serves these as plain files.
export const prerender = true;

const { data: settings } = await loadQuery<SETTINGS_QUERY_RESULT>({ query: SETTINGS_QUERY, params: { lang: 'en' } });
const site = { name: settings?.name ?? 'Everline Advisory' };
---

<BaseLayout title={`Thanks — ${site.name}`} noindex>
  <main id="main" class="thanks">
    <p class="eyebrow">MESSAGE RECEIVED</p>
    <h1 class="t-h2">Thanks — I’ll follow up within one business day.</h1>
    <a class="btn btn--outline" href="/">Back to {site.name}</a>
  </main>
</BaseLayout>

<style>
  .thanks {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
    max-width: 640px;
    margin-inline: auto;
    padding: var(--sp-xl) var(--gutter);
  }
</style>
