---
import { stegaClean } from '@sanity/client/stega';
import type { ContactBlockData } from '../lib/sanity/types';
import type { Lang } from '../lib/i18n';
import ContactForm from './ContactForm.astro';
import SplitWords from './SplitWords.astro';

interface Props {
  block: ContactBlockData;
  /** From Site settings. */
  email: string;
  lang: Lang;
}

const { block, email, lang } = Astro.props;
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="container contact-inner" data-reveal>
    <div class="contact-intro">
      <div class="contact-heading">
        <h2 id="contact-heading" class="t-h2"><SplitWords text={block.heading} /></h2>
        <p class="t-body contact-body">{block.body}</p>
      </div>
      <div class="contact-direct">
        <p class="direct-label">{block.directLabel}</p>
        <a class="direct-email" href={`mailto:${stegaClean(email)}`}>{email}</a>
      </div>
    </div>
    <ContactForm block={block} lang={lang} />
  </div>
</section>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-md);
    align-items: start;
  }
  .contact-intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }
  .contact-heading {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contact-body {
    color: var(--c-text-muted);
  }
  .contact-direct {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .direct-label {
    font-size: 12px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--c-text-muted);
  }
  .direct-email {
    align-self: flex-start;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--c-accent);
  }
  .direct-email:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 839.98px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
