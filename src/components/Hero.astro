---
import { stegaClean } from '@sanity/client/stega';
import type { HeroBlockData } from '../lib/sanity/types';
import { buildSrcset, hotspotPosition, urlFor, HERO_SIZES, HERO_WIDTHS } from '../lib/sanity/image';

interface Props {
  block: HeroBlockData;
}

const { block } = Astro.props;
const image = block.image;
const dimensions = image?.asset?.metadata?.dimensions;

const srcset = image?.asset ? buildSrcset(image, HERO_WIDTHS) : undefined;
const src = image?.asset ? urlFor(image).width(1280).url() : undefined;
---

<!-- No reveal here on purpose: the portrait is the LCP element. -->
<section class="hero" id="home" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-media">
      {src && (
        <img
          class="hero-img"
          src={src}
          srcset={srcset}
          sizes={HERO_SIZES}
          alt={stegaClean(image?.alt) ?? ''}
          width={dimensions?.width}
          height={dimensions?.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style={`object-position: ${hotspotPosition(image?.hotspot)}`}
        />
      )}
    </div>
    <div class="hero-copy">
      <div class="hero-text">
        <div class="hero-heading">
          <p class="eyebrow">{block.eyebrow}</p>
          <h1 id="hero-heading" class="t-h1">{block.heading}</h1>
        </div>
        <p class="hero-body t-body">{block.body}</p>
        <div class="hero-actions">
          {block.cta && <a class="btn btn--solid" href={`#${stegaClean(block.cta.anchor)}`}>{block.cta.label}</a>}
          {block.note && <p class="hero-note">{block.note}</p>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    scroll-margin-top: 96px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
    max-width: var(--w-hero);
    margin-inline: auto;
  }
  .hero-media {
    position: relative;
    min-height: 100%;
    background: #d9d9d7;
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* object-position comes from the editor's hotspot (inline style) */
    object-fit: cover;
  }
  .hero-copy {
    display: flex;
    align-items: center;
    padding: var(--sp-xl) var(--sp-md);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 100%;
    max-width: 592px;
  }
  .hero-heading {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-body {
    color: var(--c-text-nav);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .hero-note {
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-text-muted);
  }

  /* measured on the live site: 28px on tablet, 24px on phone */
  @media (max-width: 1439.98px) {
    .hero-text {
      gap: 28px;
    }
  }

  @media (max-width: 839.98px) {
    .hero {
      scroll-margin-top: 72px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      height: 480px;
    }
    .hero-copy {
      padding: var(--sp-xl) var(--gutter);
      justify-content: center;
    }
    .hero-text {
      gap: 24px;
      max-width: var(--w-stacked);
    }
  }
</style>
