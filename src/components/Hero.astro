---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero-renata.jpg';
import { hero } from '../data/site';
---

<!-- No reveal here on purpose: the portrait is the LCP element. -->
<section class="hero" id="home" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-media">
      <Picture
        src={heroImage}
        alt={hero.imageAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(min-width: 840px) 64vw, 185vw"
        priority
        class="hero-img"
      />
    </div>
    <div class="hero-copy">
      <div class="hero-text">
        <div class="hero-heading">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-heading" class="t-h1">{hero.heading}</h1>
        </div>
        <p class="hero-body t-body">{hero.body}</p>
        <div class="hero-actions">
          <a class="btn btn--solid" href={hero.cta.href}>{hero.cta.label}</a>
          <p class="hero-note">{hero.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    scroll-margin-top: 96px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
    max-width: var(--w-hero);
    margin-inline: auto;
  }
  .hero-media {
    position: relative;
    min-height: 100%;
    background: #d9d9d7;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) {
    object-fit: cover;
    object-position: center;
  }
  .hero-copy {
    display: flex;
    align-items: center;
    padding: var(--sp-xl) var(--sp-md);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 100%;
    max-width: 592px;
  }
  .hero-heading {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-body {
    color: var(--c-text-nav);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .hero-note {
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-text-muted);
  }

  /* measured on the live site: 28px on tablet, 24px on phone */
  @media (max-width: 1439.98px) {
    .hero-text {
      gap: 28px;
    }
  }

  @media (max-width: 839.98px) {
    .hero {
      scroll-margin-top: 72px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      height: 480px;
    }
    .hero-copy {
      padding: var(--sp-xl) var(--gutter);
      justify-content: center;
    }
    .hero-text {
      gap: 24px;
      max-width: var(--w-stacked);
    }
  }
</style>
