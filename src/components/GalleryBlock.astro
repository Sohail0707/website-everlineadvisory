---
/**
 * Gallery: 1–4 photos. The arrangement comes from src/lib/gallery.ts (planGallery);
 * this component only turns that plan into markup.
 *
 * Images: served by Sanity's CDN in several widths (srcset) as AVIF/WebP, lazy-loaded, with
 * real width/height attributes. Each tile has a fixed shape (aspect-ratio), so nothing shifts
 * while photos load. When a tile crops a photo, the editor's hotspot decides what stays visible.
 */
import { stegaClean } from '@sanity/client/stega';
import type { GalleryBlockData } from '../lib/sanity/types';
import { buildSrcset, hotspotPosition, urlFor } from '../lib/sanity/image';
import { planGallery, type GalleryLayout } from '../lib/gallery';
import SplitWords from './SplitWords.astro';

interface Props {
  block: GalleryBlockData;
}

const { block } = Astro.props;
// Only photos that actually have a file (a half-finished draft may have an empty slot).
const images = (block.images ?? []).filter((image) => image.asset).slice(0, 4);

// `layout` drives logic, so it must be stega-free.
const layout = (stegaClean(block.layout) ?? 'auto') as GalleryLayout;
// Photos without size info count as landscape (3:2).
const ratios = images.map((image) => image.asset?.metadata?.dimensions?.aspectRatio ?? 1.5);
const plan = planGallery(layout, ratios);
const id = stegaClean(block.anchor) || undefined;

const WIDTHS = [480, 720, 960, 1280, 1600, 2000];

/** Widths worth offering for this photo: never larger than the original file. */
function widthsFor(originalWidth: number | null | undefined) {
  const usable = WIDTHS.filter((w) => !originalWidth || w <= originalWidth);
  return usable.length > 0 ? usable : [originalWidth ?? WIDTHS[0]];
}

/** `sizes`: full width on phones; on larger screens the tile's share of the 1312px content column. */
function sizesFor(share: number) {
  const px = Math.round(1312 * share);
  const vw = Math.round(100 * share);
  return `(min-width: 1440px) ${px}px, (min-width: 840px) ${vw}vw, 100vw`;
}
---

{images.length > 0 && (
  <section class="section gallery-section" id={id} aria-labelledby={block.heading ? `gallery-${block._key}` : undefined}>
    <div class="container gallery-inner" data-reveal>
      {block.heading && (
        <h2 id={`gallery-${block._key}`} class="t-h2 t-light"><SplitWords text={block.heading} /></h2>
      )}
      <div class={`gallery gallery--${plan.variant}`} style={`--columns: ${plan.columns}`}>
        {plan.tiles.map((tile) => {
          const image = images[tile.index];
          const dimensions = image.asset?.metadata?.dimensions;
          return (
            <figure
              class:list={['tile', tile.className, { 'is-fill': !tile.ratio }]}
              style={`${tile.ratio ? `--ratio: ${tile.ratio.toFixed(4)};` : ''} --ratio-mobile: ${tile.mobileRatio.toFixed(4)}`}
            >
              <div class="frame">
                <img
                  src={urlFor(image).width(1280).url()}
                  srcset={buildSrcset(image, widthsFor(dimensions?.width))}
                  sizes={sizesFor(tile.widthShare)}
                  alt={stegaClean(image.alt) ?? ''}
                  width={dimensions?.width}
                  height={dimensions?.height}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${hotspotPosition(image.hotspot)}`}
                />
              </div>
              {image.caption && <figcaption class="caption">{image.caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .gallery-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }
  .gallery {
    display: grid;
    grid-template-columns: var(--columns);
    gap: var(--sp-xxs);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    margin: 0;
  }
  /* The frame has the tile's shape; the photo fills it (cropped around the hotspot if needed). */
  .frame {
    position: relative;
    /* keep the exact shape even if a neighbour's caption makes the row taller */
    flex: none;
    aspect-ratio: var(--ratio, auto);
    overflow: hidden;
    background: #d9d9d7;
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .caption {
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.1em;
    color: var(--c-text-nav);
  }

  /* One portrait photo: don't let it get taller than the screen. */
  .tile.is-narrow {
    width: 50%;
    justify-self: center;
  }
  /* Three photos: the large one fills the first column, the other two stack beside it. */
  .gallery--trio {
    grid-template-rows: 1fr 1fr;
  }
  .gallery--trio .is-large {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  /* The two small tiles have no shape of their own: they share the large tile's height. */
  .tile.is-fill .frame {
    flex: 1 1 auto;
    min-height: 0;
  }
  /* Featured: the first photo is a banner across the whole width. */
  .gallery--featured .is-banner {
    grid-column: 1 / -1;
  }

  @media (max-width: 839.98px) {
    /* Phones: one photo per row, each in its natural shape. */
    .gallery {
      grid-template-columns: 1fr;
    }
    .gallery--trio .is-large,
    .gallery--featured .is-banner {
      grid-column: auto;
      grid-row: auto;
    }
    .tile.is-narrow {
      width: 100%;
    }
    .frame,
    .tile.is-fill .frame {
      flex: none;
      aspect-ratio: var(--ratio-mobile);
    }
  }
</style>
