---
import { stegaClean } from '@sanity/client/stega';
import type { SettingsData } from '../lib/sanity/types';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  settings: SettingsData;
  lang: Lang;
}

const { settings, lang } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner" data-reveal>
    <div class="footer-col">
      <p class="footer-mark">{settings.name}</p>
      <p class="footer-tagline">{settings.tagline}</p>
    </div>
    <nav class="footer-col" aria-label={ui[lang].footerNav}>
      <ul class="footer-links">
        {settings.nav?.map((item) => (
          <li><a href={`#${stegaClean(item.anchor)}`}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="footer-col">
      <a class="footer-email" href={`mailto:${stegaClean(settings.email)}`}>{settings.email}</a>
      <p class="footer-copy">{settings.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-bg-footer);
    padding: 48px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    max-width: var(--w-content);
    margin-inline: auto;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }
  .footer-mark {
    font-family: var(--ff-serif);
    font-size: 24px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-footer-heading);
  }
  .footer-tagline {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--c-footer-text);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
  }
  .footer-links a {
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-footer-text);
    transition: color 0.2s ease;
  }
  .footer-links a:hover {
    color: var(--c-footer-heading);
  }
  .footer-email {
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-footer-heading);
  }
  .footer-copy {
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    color: var(--c-footer-muted);
  }

  @media (max-width: 1439.98px) {
    .site-footer {
      padding: 36px;
    }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: var(--w-content);
    }
  }
  @media (max-width: 839.98px) {
    .site-footer {
      padding: 36px 18px;
    }
    .footer-inner {
      max-width: var(--w-stacked);
    }
  }
</style>
