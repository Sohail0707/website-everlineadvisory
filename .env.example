# Copy to .env for local development. On Netlify, set these under Site configuration → Environment variables.

# Sanity project (public: these are visible in the browser anyway)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# The deployed Studio; Visual Editing links point here
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server only. Sanity → API → Tokens → "Viewer". Needed for draft mode / Visual Editing.
SANITY_API_READ_TOKEN=
# Random string that signs the draft-mode cookie. e.g. `openssl rand -hex 32`
SANITY_PREVIEW_SECRET=

# Same value as the secret of the Sanity webhook that purges the cache (README → Webhook).
SANITY_REVALIDATE_SECRET=

# "true" = server mode (Netlify: SSR + CDN cache + Visual Editing). "false" = plain static build.
SANITY_VISUAL_EDITING=false
